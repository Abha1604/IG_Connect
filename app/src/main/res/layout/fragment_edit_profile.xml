<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_profile"
            android:scaleType="centerCrop"
            android:background="@drawable/profile_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Name -->
        <EditText
            android:id="@+id/editProfileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jiya Sharma"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/custom_green"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:hint="Enter your name"
            app:layout_constraintTop_toBottomOf="@id/profileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Email -->
        <EditText
            android:id="@+id/editProfileEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="jiya.sharma@example.com"
            android:textSize="16sp"
            android:textColor="@color/gray_700"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:hint="Enter your email"
            app:layout_constraintTop_toBottomOf="@id/editProfileName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Bio -->
        <EditText
            android:id="@+id/editProfileBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="CSE Student 2028 | App Dev Enthusiast"
            android:textSize="14sp"
            android:textColor="@color/gray_600"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:hint="Enter your bio"
            app:layout_constraintTop_toBottomOf="@id/editProfileEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Skills Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/skillsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/editProfileBio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/skillsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skills"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/custom_green"/>

                <EditText
                    android:id="@+id/editSkillsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Kotlin, Java, Firebase, UI/UX, Flutter"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="8dp"
                    android:hint="Enter your skills"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Projects Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/projectsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/skillsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/projectsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projects"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/custom_green"/>

                <EditText
                    android:id="@+id/editProjectDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IGConnect App - Platform to connect IGDTUW students alumni"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="8dp"
                    android:hint="Enter project details"/>

                <EditText
                    android:id="@+id/editProjectTech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"

                    android:text="Tech: Kotlin, Firebase, Firestore"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="4dp"
                    android:hint="Enter project tech stack"/>

                <EditText
                    android:id="@+id/editProjectGitHub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="GitHub: github.com/JiyaSharma/IGConnect"
                    android:textSize="14sp"
                    android:textColor="@color/custom_green"
                    android:layout_marginTop="4dp"
                    android:hint="Enter project GitHub link"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GitHub and LinkedIn Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/socialLinksCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/projectsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/socialLinksTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Social Links"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/custom_green"/>

                <EditText
                    android:id="@+id/editGitHubLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GitHub: https://github.com/JiyaSharma"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="8dp"
                    android:hint="Enter GitHub link"/>

                <EditText
                    android:id="@+id/editLinkedInLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LinkedIn: https://linkedin.com/in/jiya-sharma"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="4dp"
                    android:hint="Enter LinkedIn link"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Save Button -->
        <Button
            android:id="@+id/saveProfileButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/custom_green"
            android:text="Save Profile"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/socialLinksCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
