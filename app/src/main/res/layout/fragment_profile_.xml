
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="120dp"
            android:layout_marginTop="20dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_profile"
            android:scaleType="centerCrop"
            android:background="@drawable/profile_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Name -->
        <TextView
            android:id="@+id/profileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jiya Sharma"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/custom_green"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/profileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Email -->
        <TextView
            android:id="@+id/profileEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="jiya.sharma@igdtuw.ac.in"
            android:textSize="16sp"
            android:textColor="@color/gray_700"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/profileName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Bio -->
        <TextView
            android:id="@+id/profileBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CSE Student 2028| App Dev Enthusiast"
            android:textSize="14sp"
            android:textColor="@color/gray_600"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/profileEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Skills Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/skillsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/profileBio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/skillsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skills"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/custom_green"/>

                <TextView
                    android:id="@+id/skillsList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kotlin, Java, Firebase, UI/UX, Flutter"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Projects Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/projectsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/skillsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/projectsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projects"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/custom_green"/>

                <TextView
                    android:id="@+id/projectDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IGConnect App - Platform to connect IGDTUW students alumni"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/projectTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tech: Kotlin, Firebase, Firestore"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/projectGitHub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub: github.com/JiyaSharma/IGConnect"
                    android:textSize="14sp"
                    android:textColor="@color/custom_green"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GitHub and LinkedIn Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/socialLinksCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/projectsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/socialLinksTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Social Links"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/custom_green"/>

                <TextView
                    android:id="@+id/githubLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub: https://github.com/JiyaSharma"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/linkedinLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LinkedIn: https://linkedin.com/in/jiya-sharma"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Edit Profile Button -->
        <Button
            android:id="@+id/editProfileButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/custom_green"
            android:text="Edit Profile"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/socialLinksCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>




